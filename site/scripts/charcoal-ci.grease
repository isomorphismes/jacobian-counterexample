#!/usr/bin/env grease
set -eu -o pipefail
test "$#" -eq 2
var root = ARGV[0]
var output = ARGV[1]
mkdir -p "$output"
diff -qr "$root/.baseline/site/src/math" "$root/site/src/math"
diff -qr "$root/.baseline/site/src/viewer" "$root/site/src/viewer"
diff -qr "$root/.baseline/site/public" "$root/site/public"
cmp "$root/.baseline/site/src/main.ts" "$root/site/src/main.ts"
cmp "$root/.baseline/site/index.html" "$root/site/index.html"
cd "$root/site"
npm ci
npm test
npm run build:web
node node_modules/playwright-core/cli.js install --with-deps chromium
export CHROME_PATH = $(node --input-type=module -e 'import { chromium } from "playwright-core"; process.stdout.write(chromium.executablePath())')
export SITE_URL = 'http://127.0.0.1:4174/'
export BROWSER_QA_OUTPUT = "$output"
fork { npm run preview -- --port 4174 > "$output/preview.log" 2>&1 }
var preview_pid = $!
trap 'kill "$preview_pid"' EXIT
var ready = false
for attempt in @(seq 1 40) {
  try { curl --fail --silent --output /dev/null "$SITE_URL" }
  if (_error.code === 0) { setvar ready = true; break }
  sleep 0.25
}
if (not ready) { cat "$output/preview.log" >&2; exit 1 }
npm run qa:browser
